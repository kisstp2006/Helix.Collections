<Project Sdk="Microsoft.NET.Sdk">
  <!-- The C# tests of the containers: run by the C++ test program under the .NET host. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Helix.Collections.Tests</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="HelixEngine.CoreModule">
      <HintPath>$(HelixCoreModule)</HintPath>
    </Reference>
    <Reference Include="Helix.Mathematics">
      <HintPath>$([System.IO.Path]::GetDirectoryName($(HelixCoreModule)))/Helix.Mathematics.dll</HintPath>
    </Reference>
    <Reference Include="Helix.Collections">
      <HintPath>$(HelixCollections)</HintPath>
    </Reference>
    <Reference Include="Helix.Scripting.Runtime">
      <HintPath>$(HelixScriptingRuntime)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
